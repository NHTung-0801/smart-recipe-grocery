<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Phần Năng lượng (Calo) -->
        <TextView
            android:id="@+id/tvCalorieTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Năng lượng (Calo)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ProgressBar
            android:id="@+id/progressCalories"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progressTint="#FF9800"
            app:layout_constraintTop_toBottomOf="@id/tvCalorieTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvCalorieText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textStyle="bold"
            android:textColor="#FF9800"
            app:layout_constraintTop_toBottomOf="@id/progressCalories"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="1450 / 2000 Calo" />

        <!-- Phần Đa lượng (Macro) -->
        <TextView
            android:id="@+id/tvMacroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Đa lượng (Macro)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212121"
            app:layout_constraintTop_toBottomOf="@id/tvCalorieText"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Protein -->
        <TextView
            android:id="@+id/tvProteinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Protein (Đạm)"
            android:textColor="#F44336"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvMacroTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <ProgressBar
            android:id="@+id/progressProtein"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressTint="#F44336"
            app:layout_constraintTop_toBottomOf="@id/tvProteinTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvProteinText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/progressProtein"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="110g / 150g" />

        <!-- Carbs -->
        <TextView
            android:id="@+id/tvCarbsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Carbs (Tinh bột)"
            android:textColor="#2196F3"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvProteinText"
            app:layout_constraintStart_toStartOf="parent" />

        <ProgressBar
            android:id="@+id/progressCarbs"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressTint="#2196F3"
            app:layout_constraintTop_toBottomOf="@id/tvCarbsTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvCarbsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/progressCarbs"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="160g / 200g" />

        <!-- Fat -->
        <TextView
            android:id="@+id/tvFatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fat (Chất béo)"
            android:textColor="#FFC107"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvCarbsText"
            app:layout_constraintStart_toStartOf="parent" />

        <ProgressBar
            android:id="@+id/progressFat"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressTint="#FFC107"
            app:layout_constraintTop_toBottomOf="@id/tvFatTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvFatText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/progressFat"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="45g / 65g" />

        <!-- Bảng tính TDEE -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/tvFatText" />

        <TextView
            android:id="@+id/tvUpdateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Cập nhật Chỉ số cơ thể"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/llInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintTop_toBottomOf="@id/tvUpdateTitle">

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Nặng (kg)"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etHeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:hint="Cao (cm)"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etAge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Tuổi"
                android:inputType="number" />
        </LinearLayout>
        <!-- Phần chọn Giới tính -->
        <TextView
            android:id="@+id/tvGenderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Giới tính:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/llInputs"
            app:layout_constraintStart_toStartOf="parent" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvGenderTitle"
            app:layout_constraintStart_toStartOf="parent">

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nam"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nữ"
                android:layout_marginStart="24dp" />
        </RadioGroup>

        <!-- Phần chọn Mức độ vận động -->
        <TextView
            android:id="@+id/tvActivityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mức độ vận động:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/rgGender"
            app:layout_constraintStart_toStartOf="parent" />

        <Spinner
            android:id="@+id/spinnerActivity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="#EEEEEE"
            app:layout_constraintTop_toBottomOf="@id/tvActivityTitle" />

        <!-- LƯU Ý: Nút bấm cũ được cập nhật lại app:layout_constraintTop_toBottomOf trỏ xuống spinnerActivity -->
        <Button
            android:id="@+id/btnUpdateTDEE"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tính TDEE &amp; Cập nhật Macro"
            app:layout_constraintTop_toBottomOf="@id/spinnerActivity" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>